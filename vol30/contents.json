 },
 {
  "t": "sukta",
  "no": "೧೭೩",
  "text": "ಆ ತ್ವಾಹಾರ್ಷಂ ಎಂಬ ನೂರ ಎಪ್ಪತ್ತಮೂರನೆಯ ಸೂಕ್ತ 1168",
  "src": 321
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ರಾಜನ ರಾಜ್ಯಾಭಿಷೇಕ ವಿಷಯ",
