  "text": "ಯಮಶಬ್ದದ ನಿರ್ವಚನ",
  "page": 853,
  "src": 200
 },
 {
  "t": "item",
  "text": "ಯಸ್ಮಿನ್ವೃಕ್ಷೇ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನ",
  "page": 853,
  "src": 201
 },
