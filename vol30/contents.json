  "src": 319
 },
 {
  "t": "sukta",
  "no": "೧೭೨",
  "text": "ಆ ಯಾಹಿ ಮನಸಾ ಎಂಬ ನೂರ ಎಪ್ಪತ್ತೆರಡನೆಯ ಸೂಕ್ತ 1164",
