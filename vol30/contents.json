[
 {
  "t": "center",
  "text": "ಹತ್ತನೆಯ ಮಂಡಲದ ಸೂಕ್ತಗಳು.",
  "src": 3
 },
 {
  "t": "center",
  "text": "ಎಂಟನೆಯ ಅಷ್ಟಕದಲ್ಲಿ ಐದನೆಯ ಅಧ್ಯಾಯ",
  "src": 5
 },
 {
  "t": "sukta",
  "no": "೯೫",
  "text": "ಹಯೇ ಜಾಯೇ ಎಂಬ ತೊಂಭತ್ತೈದನೆಯ ಸೂಕ್ತ 1",
  "src": 7
 },
 {
  "t": "item",
  "text": "ಪೀಠಿಕೆ—ಉರ್ವಶೀ ಮತ್ತು ಪುರೂರವಾಃ ಎಂಬುವರ ವಿಷಯ",
  "page": 1,
  "src": 8
 },
 {
  "t": "item",
  "text": "ಉರ್ವಶೀ ಮತ್ತು ಪುರೂರವಾಃ ಎಂಬುವರ ಸಂವಾದ",
  "page": 10,
  "src": 9
 },
 {
  "t": "item",
  "text": "ಈ ಸೂಕ್ತದ ವಿಷಯದಲ್ಲಿ ಪಾಶ್ಚಾತ್ಯ ಪಂಡಿತರ ಅಭಿಪ್ರಾಯ",
  "page": 12,
  "src": 10
 },
 {
  "t": "item",
  "text": "ಉರ್ವಶೀ ಶಬ್ದದ ನಿರ್ವಚನ",
  "page": 14,
  "src": 11
 },
 {
  "t": "item",
  "text": "ಅಪ್ಸರಾಃ ಶಬ್ದದ ನಿರ್ವಚನ",
  "page": 15,
  "src": 12
 },
 {
  "t": "item",
  "text": "ಶೇಷ, ವೈತಸ ಎಂಬ ಶಬ್ದಗಳ ನಿರ್ವಚನ",
  "page": 28,
  "src": 13
 },
 {
  "t": "item",
  "text": "ಸಮಸ್ಮಿಞ್ಚಯಮಾನೇ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತ",
  "page": 32,
  "src": 14
 },
 {
  "t": "item",
  "text": "ವಿದ್ಯುನ್ನ ಯಾ ಪತಂತೀ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತ",
  "page": 38,
  "src": 15
 },
 {
  "t": "sukta",
  "no": "೯೬",
  "text": "ಪ್ರ ತೇ ಮಹೇ ಎಂಬ ತೊಂಭತ್ತಾರನೆಯ ಸೂಕ್ತ 50",
  "src": 16
 },
 {
  "t": "sukta",
  "no": "೯೭",
  "text": "ಯಾ ಓಷಧೀಃ ಪೂರ್ವಾ ಜಾತಾಃ ಎಂಬ ತೊಂಭತ್ತೇಳನೆಯ ಸೂಕ್ತ 69",
  "src": 17
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ಓಷಧಿಶಬ್ದನಿರ್ವಚನ ಇತ್ಯಾದಿ",
  "page": 69,
  "src": 18
 },
 {
  "t": "item",
  "text": "ಯಾ ಓಷಧೀಃ ಪೂರ್ವಾ ಜಾತಾಃ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತ",
  "page": 73,
  "src": 19
 },
 {
  "t": "item",
  "text": "ಆತ್ಮಾ ಯಕ್ಷಸ್ಯ ನಶ್ಯತಿ ಎಂಬ ವಾಕ್ಯದ ನಿರುಕ್ತ",
  "page": 85,
  "src": 20
 },
 {
  "t": "sukta",
  "no": "೯೮",
  "text": "ಬೃಹಸ್ಪತೇ ಪ್ರತಿ ಮೇ ಎಂಬ ತೊಂಭತ್ತೆಂಟನೆಯ ಸೂಕ್ತ 97",
  "src": 21
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ದೇವಾಪಿ ಮತ್ತು ಶಂತನು ಎಂಬ ರಾಜರ ವಿಷಯ",
  "page": 97,
  "src": 22
 },
 {
  "t": "item",
  "text": "ಆರ್ಷ್ಟಿಷೇಣೋ ಹೋತ್ರಂ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತ",
  "page": 108,
  "src": 23
 },
 {
  "t": "item",
  "text": "ಯದ್ದೇವಾಪಿಃ ಶಂತನವೇ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತ",
  "page": 112,
  "src": 24
 },
 {
  "t": "sukta",
  "no": "೯೯",
  "text": "ಕಂ ನಶ್ಚಿತ್ರಂ ಎಂಬ ತೊಂಭತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತ 119",
