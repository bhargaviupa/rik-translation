  "src": 322
 },
 {
  "t": "sukta",
  "no": "೧೭೪",
  "text": "ಅಭೀವರ್ತೆನ ಹವಿಷಾ ಎಂಬ ನೂರ ಎಪ್ಪತ್ತನಾಲ್ಕನೆಯ ಸೂಕ್ತ 1176",
  "src": 323
 },
 {
  "t": "sukta",
  "no": "೧೭೫",
