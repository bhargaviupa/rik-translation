 },
 {
  "t": "sukta",
  "no": "೧೦೧",
  "text": "ಉದ್ಬುಧ್ಯಧ್ವಂ ಎಂಬ ನೂರ ಒಂದನೆಯ ಸೂಕ್ತ 149",
  "src": 32
 },
 {
  "t": "item",
  "text": "ಸೃಣಿಶಬ್ದದ ನಿರ್ವಚನ",
