  "no": "೧೬೩",
  "text": "ಅಕ್ಷೀಭ್ಯಾಂ ತೇ ಎಂಬ ನೂರ ಅರವತ್ತಮೂರನೆಯ ಸೂಕ್ತ 1101",
  "src": 299
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ",
  "page": 1101,
  "src": 300
 },
 {
  "t": "sukta",
  "no": "೧೬೪",
  "text": "ಅಪೇಹಿ ಮನಸಸ್ಪತೇ ಎಂಬ ನೂರ ಅರವತ್ತನಾಲ್ಕನೆಯ ಸೂಕ್ತ 1108",
  "src": 301
 },
 {
  "t": "sukta",
  "no": "೧೬೫",
  "text": "ದೇವಾಃ ಕಪೋತಃ ಎಂಬ ನೂರ ಅರವತ್ತೈದನೆಯ ಸೂಕ್ತ 1114",
  "src": 302
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ಪಕ್ಷಿಗಳ ವಿಷಯ, ಕಪೋತ ನೈಋತ್ಯ ಎಂಬ ಋಷಿಯ ವಿಷಯ ಇತ್ಯಾದಿ",
  "page": 1114,
  "src": 303
 },
 {
  "t": "sukta",
  "no": "೧೬೬",
  "text": "ಋಷಭಂ ಮಾ ಎಂಬ ನೂರ ಅರವತ್ತಾರನೆಯ ಸೂಕ್ತ 1123",
  "src": 304
 },
 {
  "t": "item",
  "text": "ಈ ಸೂಕ್ತದ ಕೊನೆಯಲ್ಲಿ ಪಠಿಸಬೇಕಾದ ಪರಿಶಿಷ್ಟ ಮಂತ್ರಗಳು",
  "page": 1129,
  "src": 305
 },
 {
  "t": "sukta",
  "no": "೧೬೭",
  "text": "ಶುಭ್ಯೇದಮಿಂದ್ರ ಎಂಬ ನೂರ ಅರವತ್ತೇಳನೆಯ ಸೂಕ್ತ 1131",
  "src": 306
 },
 {
  "t": "sukta",
  "no": "೧೬೮",
  "text": "ವಾತಸ್ಯ ನು ಮಹಿಮಾನಂ ಎಂಬ ನೂರ ಅರವತ್ತೆಂಟನೆಯ ಸೂಕ್ತ 1137",
  "src": 307
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ವಾಯು ದೇವತೆಯ ವಿಷಯ, ವಾತ ಶಬ್ದದ ನಿರ್ವಚನ ಇತ್ಯಾದಿ",
  "page": 1137,
  "src": 308
 },
 {
  "t": "sukta",
  "no": "೧೬೯",
  "text": "ಮಯೋಭೂರ್ವಾತಃ ಎಂಬ ನೂರ ಅರವತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತ 1145",
  "src": 314
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ಗೋವುಗಳ ವಿಷಯ",
  "page": 1145,
  "src": 315
 },
 {
  "t": "sukta",
  "no": "೧೭೦",
  "text": "ವಿಭ್ರಾಡ್ ಬೃಹತ್ವಿಬತು ಎಂಬ ನೂರ ಎಪ್ಪತ್ತನೆಯ ಸೂಕ್ತ 1152",
  "src": 316
 },
 {
  "t": "sukta",
  "no": "೧೭೧",
  "text": "ತ್ವಂ ತ್ಯಮಿಟತಃ ಎಂಬ ನೂರ ಎಪ್ಪತ್ತೊಂದನೆಯ ಸೂಕ್ತ 1158",
  "src": 317
 },
 {
  "t": "item",
  "text": "ಇಂದ್ರನು ರುದ್ರಧನುಸ್ಸಿನ ಹೆದೆಯನ್ನು ಕತ್ತರಿಸಿದ ವಿಚಾರ",
  "page": 1160,
  "src": 318
 },
 {
  "t": "item",
  "text": "ಪೃಥು ಮತ್ತು ಅಸ್ತ್ರಬುಧ್ನ ಎಂಬುವರ ವಿಷಯ",
