  "t": "sukta",
  "no": "೧೧೬",
  "text": "ಪಿಬಾ ಸೋಮಂ ಮಹತೇ ಎಂಬ ನೂರ ಹದಿನಾರನೆಯ ಸೂಕ್ತ 525",
  "src": 106
 },
 {
  "t": "item",
  "text": "ಮನುಷ್ಯರಿಗಿರುವಂತೆ ದೇವತೆಗಳಿಗೆ ದೇಹಾದ್ಯಾಕಾರಗಳು, ಹಸ್ತಾದ್ಯವಯವಗಳೂ, ಆಹಾರ ಭಕ್ಷಣ, ಇತ್ಯಾದಿಗಳಿರುವವೇ ? ಎಂಬ ವಿಷಯವಿಮರ್ಶೆ",
  "page": 535,
  "src": 107
 },
 {
  "t": "item",
  "text": "ಚನಃ ಮತ್ತು ಪಚಿತ ಎಂಬ ಶಬ್ದಗಳ ನಿರ್ವಚನ",
  "page": 541,
  "src": 109
 },
 {
  "t": "sukta",
  "no": "೧೧೭",
  "text": "ನ ವಾ ಉ ದೇವಾಃ ಎಂಬ ನೂರ ಹದಿನೇಳನೆಯ ಸೂಕ್ತ 543",
  "src": 110
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ಅನ್ನ ವಿಚಾರವಾದ ವಿಷಯವಿಮರ್ಶೆ",
  "page": 543,
  "src": 111
 },
 {
  "t": "item",
  "text": "ದಾನಗಳಲ್ಲಿ ಮೂರು ವಿಧ... ಸತ್ತ್ವ, ರಜಃ, ತಮಃ ಎಂದು",
  "page": 548,
  "src": 112
 },
 {
  "t": "item",
  "text": "ಸ್ನೇಹಿತನ ಕರ್ತವ್ಯ, ಸ್ನೇಹಿತನ ಲಕ್ಷಣ",
  "page": 559,
  "src": 113
 },
 {
  "t": "item",
  "text": "ಅನ್ನ ದಾನಪ್ರಶಂಸೆ ಇತ್ಯಾದಿ",
  "page": 561,
  "src": 114
 },
 {
  "t": "item",
  "text": "ಅನ್ನ ದಾನಕ್ಕೆ ಅರ್ಹನಾರು ?",
  "page": 563,
  "src": 115
 },
 {
  "t": "item",
  "text": "ಒಂದೇ ಮನೆಯಲ್ಲಿರುವ ಬಂಧುಬಾಂಧವರ ಗುಣವು ಒಂದೇ ವಿಧವಾಗಿರುವುದಿಲ್ಲ ಇತ್ಯಾದಿ",
  "page": 568,
  "src": 116
 },
 {
  "t": "sukta",
  "no": "೧೧೮",
  "text": "ಅಗ್ನೇ ಹಂಸಿ ಎಂಬ ನೂರ ಹದಿನೆಂಟನೆಯ ಸೂಕ್ತ 569",
  "src": 117
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ರಕ್ಷೋಹಾಗ್ನಿಯ ವಿಷಯ",
  "page": 569,
  "src": 118
 },
 {
  "t": "sukta",
  "no": "೧೧೯",
  "text": "ಇತಿ ವಾ ಇತಿ ಎಂಬ ನೂರ ಹತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತ 584",
  "src": 119
 },
 {
  "t": "item",
  "text": "ನಾ ಎಂಬ ಶಬ್ದದ ಅರ್ಥ ಮತ್ತು ಪ್ರಯೋಗ",
  "page": 593,
  "src": 125
 },
 {
  "t": "center",
  "text": "ಎಂಟನೆಯ ಅಷ್ಟಕದಲ್ಲಿ ಆರನೆಯ ಅಧ್ಯಾಯವು ಸಮಾಪ್ತವು.",
  "src": 127
 },
 {
  "t": "center",
  "text": "ಏಳನೆಯ ಅಧ್ಯಾಯವು",
  "src": 129
 },
 {
  "t": "sukta",
  "no": "೧೨೦",
  "text": "ತದಿದಾಸ ಭುವನೇಷು ಜ್ಯೇಷ್ಠಂ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತನೆಯ ಸೂಕ್ತವು 599",
  "src": 131
 },
 {
  "t": "item",
  "text": "ಬ್ರಹ್ಮ ವಸ್ತುವಿನ ಸ್ವರೂಪ",
  "page": 602,
  "src": 132
 },
 {
  "t": "item",
  "text": "ಮಂದೇಹಾರುಣವೆಂಬ ದ್ವೀಪ ನಿವಾಸಿಗಳಾದ ಅಸುರರ ವಿಷಯ",
  "page": 610,
  "src": 133
 },
 {
  "t": "item",
  "text": "ಸ್ತುಶೇಯ್ಯಂ ಪುರುಷರ್ವಸಂ ಎಂಬ ಋಕ್ಕಿಗೆ ನಿರುಕ್ತವು",
  "page": 619,
  "src": 134
 },
 {
  "t": "sukta",
  "no": "೧೨೧",
  "text": "ಹಿರಣ್ಯಗರ್ಭಃ ಸಮವರ್ತತ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತೊಂದನೆಯ ಸೂಕ್ತ 625",
  "src": 135
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ಪ್ರಜಾಪತಿಗೆ ಕಃ ಎಂದು ಹೆಸರು ಬರಲು ಕಾರಣ",
  "page": 625,
  "src": 136
 },
 {
  "t": "item",
  "text": "ಹಿರಣ್ಯಗರ್ಭಶಬ್ದಾರ್ಥ ವಿಚಾರ—ಸೃಷ್ಟಿಗೆ ಪೂರ್ವದಲ್ಲಿ ಇದ್ದ ಸ್ಥಿತಿ ಇತ್ಯಾದಿ",
  "page": 629,
  "src": 137
 },
 {
  "t": "item",
  "text": "ಹಿರಣ್ಯಗರ್ಭಃ ಸಮವರ್ತತ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತವು",
  "page": 630,
  "src": 138
 },
 {
  "t": "item",
  "text": "ಪ್ರಜಾಪತಿಶಬ್ದದ ನಿರ್ವಚನ ಇತ್ಯಾದಿ",
  "page": 645,
  "src": 139
 },
 {
  "t": "sukta",
  "no": "೧೨೨",
  "text": "ವಸುಂ ನ ಚಿತ್ರಂ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತೆರಡನೆಯ ಸೂಕ್ತ 646",
  "src": 140
 },
 {
  "t": "sukta",
  "no": "೧೨೩",
  "text": "ಅಯಂ ವೇನಶ್ಚೋದಯತ್ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತಮೂರನೆಯ ಸೂಕ್ತ 659",
  "src": 141
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ವೇನಶಬ್ದನಿರ್ವಚನ ಇತ್ಯಾದಿ",
  "page": 659,
  "src": 142
 },
 {
  "t": "item",
  "text": "ಅಯಂ ವೇನಶ್ಚೋದಯತ್ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತ ಇತ್ಯಾದಿ",
  "page": 663,
  "src": 143
 },
 {
  "t": "sukta",
  "no": "೧೨೪",
  "text": "ಇಮಂ ನೋ ಅಗ್ನೇ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತನಾಲ್ಕನೆಯ ಸೂಕ್ತ 675",
  "src": 144
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ",
  "page": 675,
  "src": 145
 },
 {
  "t": "item",
  "text": "ಪಂಚೆಯಾಮಂ ಎಂಬ ಶಬ್ದದ ವಿವರಣೆ",
  "page": 677,
  "src": 146
 },
 {
  "t": "item",
  "text": "ತ್ರಿವೃತಂ, ಸಪ್ತತಂತುಂ ಎಂಬ ಶಬ್ದಗಳ ವಿವರಣೆ",
  "page": 678,
  "src": 147
 },
 {
  "t": "sukta",
  "no": "೧೨೫",
  "text": "ಅಹಂ ರುದ್ರೇಭಿರ್ವಸುಭಿಃ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತೈದನೆಯ ಸೂಕ್ತ 689",
  "src": 148
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ— ಅಹಂ ಸುವೇ ಪಿತರಮಸ್ಯ ಮೂರ್ಧನಿ ಎಂಬ ಋಕ್ಕಿನ ವಿಶೇಷ ವಿವರಣೆ",
  "page": 700,
  "src": 149
 },
 {
  "t": "sukta",
  "no": "೧೨೬",
  "text": "ನ ತಮಂಹೋ ನ ದುರಿತಂ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತಾರನೆಯ ಸೂಕ್ತ 703",
  "src": 151
 },
 {
  "t": "sukta",
  "no": "೧೨೭",
  "text": "ರಾತ್ರಿ ವ್ಯಖ್ಯದಾಯತೀ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತೇಳನೆಯ ಸೂಕ್ತ 713",
  "src": 157
 },
 {
  "t": "item",
  "text": "ಪೀಠಿಕೆ—ರಾತ್ರೀಸೂಕ್ತದ ಮಹಿಮೆ, ಜಪವಿಧಾನ ಇತ್ಯಾದಿ",
  "page": 713,
  "src": 158
 },
 {
  "t": "item",
  "text": "ರಾತ್ರೀಸೂಕ್ತದ ಪರಿಶಿಷ್ಟ ಮಂತ್ರಗಳು",
  "page": 726,
  "src": 159
 },
 {
  "t": "sukta",
  "no": "೧೨೮",
  "text": "ಮಮಾಗ್ನೇ ವರ್ಚಃ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತೆಂಟನೆಯ ಸೂಕ್ತ 728",
  "src": 160
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ",
  "page": 728,
  "src": 161
 },
 {
  "t": "item",
  "text": "ಈ ಸೂಕ್ತದ ಕೊನೆಯಲ್ಲಿ ಪಠಿಸಬೇಕಾದ ಪರಿಶಿಷ್ಟ ಮಂತ್ರಗಳು",
  "page": 744,
  "src": 162
 },
 {
  "t": "sukta",
  "no": "೧೨೯",
  "text": "ನಾಸದಾಸೀತ್ ಎಂಬ ನೂರ ಇಪ್ಪತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತ 749",
  "src": 163
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ಸೃಷ್ಟಿಗೆ ಪೂರ್ವದಲ್ಲಿದ್ದ ಸ್ಥಿತಿ ವಿವರಣೆ ಇತ್ಯಾದಿ",
  "page": 749,
  "src": 164
 },
 {
  "t": "item",
  "text": "ಅಸತ್ ಸತ್ ಎಂಬ ಶಬ್ದಗಳ ವಿವರಣೆ, ಸೃಷ್ಟಿಕ್ರಮ",
  "page": 755,
  "src": 165
 },
 {
  "t": "item",
  "text": "ಸಮಸ್ತ ವಸ್ತುಗಳಲ್ಲಿಯೂ ಚೈತನ್ಯವು ಅಡಗಿರುವುದು ಎಂದರೆ ಪರಮಾತ್ಮನು ಸಮಸ್ತವಸ್ತುಗಳನ್ನು ಪ್ರವೇಶಿಸಿ ವ್ಯಾಪಿಸಿರುವನು",
  "page": 756,
  "src": 166
 },
 {
  "t": "item",
  "text": "ಸೃಷ್ಟಿಗೆ ಪೂರ್ವದಲ್ಲಿ ಏನಿದ್ದಿತು ?",
  "page": 758,
  "src": 168
 },
 {
  "t": "item",
  "text": "ಮೃತ್ಯು, ಕಾಲವಿಭಾಗ ಇತ್ಯಾದಿ ವಿವರಣೆ",
  "page": 762,
  "src": 169
 },
 {
  "t": "item",
  "text": "ಬ್ರಹ್ಮವಲ್ಲದೆ ಬೇರೆ ವಸ್ತುವಿಲ್ಲ",
  "page": 765,
  "src": 170
 },
 {
  "t": "item",
  "text": "ಜಗದುತ್ಪತ್ತಿಯು ಹೇಗಾಯಿತು ?",
  "page": 767,
  "src": 171
 },
 {
  "t": "item",
  "text": "ಪರಮಾತ್ಮನು ಸೃಷ್ಟಿಯನ್ನು ಹೇಗೆ ಮಾಡಿದನು ?",
  "page": 771,
  "src": 172
 },
 {
  "t": "item",
  "text": "ಸೃಷ್ಟಿಯು ರೂಪಗೊಂಡ ವಿಧಾನ—ಸೃಷ್ಟಿಸಲ್ಪಟ್ಟ ವಸ್ತುಗಳಲ್ಲಿ ಭೋಕ್ತೃ, ಭೋಗ್ಯ ಎಂದು ಎರಡು ವಿಧ",
  "page": 774,
  "src": 173
 },
 {
  "t": "item",
  "text": "ಸೃಷ್ಟಿ ಕ್ರಮವನ್ನು ಬ್ರಹ್ಮನು ಮಾತ್ರ ತಿಳಿಯಬಲ್ಲನು, ಬೇರೆ ಯಾರೂ ತಿಳಿಯಲಾರರು ಇತ್ಯಾದಿ",
  "page": 780,
  "src": 175
 },
 {
  "t": "sukta",
  "no": "೧೩೦",
  "text": "ಯೋ ಯಜ್ಞಃ ಎಂಬ ನೂರ ಮೂವತ್ತನೆಯ ಸೂಕ್ತ 782",
  "src": 176
 },
 {
  "t": "item",
  "text": "ಸೃಷ್ಟಿ ಕ್ರಮವನ್ನು ಯಜ್ಞಕ್ಕೂ, ಯಜ್ಞವನ್ನು ವಸ್ತ್ರನಿರ್ಮಾಣಕ್ಕೂ ಹೋಲಿಸಿ ಮಾಡಿರುವ ವಿವರಣೆಯು",
  "page": 785,
  "src": 177
 },
 {
  "t": "item",
  "text": "ಯಜ್ಞವು ದೇವತೆಗಳನ್ನು ಬಿಟ್ಟು ಹೊರಟುಹೋದ ವಿಚಾರವಾದ ಉಪಾಖ್ಯಾನ ಇತ್ಯಾದಿ— ಛಂದಸ್ಸುಗಳ ಸಾರ",
  "page": 793,
  "src": 179
 },
 {
  "t": "item",
  "text": "ಮಿತ್ರಾವರುಣರಿಗೆ ವಿರಾಟ್ ಎಂಬ ಛಂದಸ್ಸು, ಇಂದ್ರನಿಗೆ ತ್ರಿಷ್ಟುಪ್ ಛಂದಸ್ಸು, ವಿಶ್ವೇದೇವತೆ ಗಳಿಗೆ ಜಗತೀಛಂದಸ್ಸು ಪ್ರಿಯವೆಂಬ ವಿಚಾರ",
  "page": 796,
  "src": 181
 },
 {
  "t": "sukta",
  "no": "೧೩೧",
  "text": "ಅಪ ಪ್ರಾಚಃ ಎಂಬ ನೂರ ಮೂವತ್ತೊಂದನೆಯ ಸೂಕ್ತ 802",
  "src": 183
 },
 {
  "t": "sukta",
  "no": "೧೩೨",
  "text": "ಈಜಾನಮಿದ್ರ್ಯಃ ಎಂಬ ನೂರ ಮೂವತ್ತೆರಡನೆಯ ಸೂಕ್ತ 813",
  "src": 189
 },
 {
  "t": "sukta",
  "no": "೧೩೩",
  "text": "ಪ್ರೋಷ್ವಸ್ಯೆ ಎಂಬ ನೂರ ಮೂವತ್ತಮೂರನೆಯ ಸೂಕ್ತ 824",
  "src": 190
 },
 {
  "t": "item",
  "text": "ಅಭೀಕೇ ಎಂಬ ಶಬ್ದದ ನಿರ್ವಚನ",
  "page": 826,
  "src": 191
 },
 {
  "t": "sukta",
  "no": "೧೩೪",
  "text": "ಉಭೇ ಯದಿಂದ್ರ ಎಂಬ ನೂರ ಮೂವತ್ತನಾಲ್ಕನೆಯ ಸೂಕ್ತ 835",
  "src": 192
 },
 {
  "t": "sukta",
  "no": "೧೩೫",
  "text": "ಯಸ್ಮಿನ್ವೃಕ್ಷೇ ಎಂಬ ನೂರ ಮೂವತ್ತೈದನೆಯ ಸೂಕ್ತ 845",
  "src": 193
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ಕಠೋಪನಿಷತ್ತಿನ ಇತಿಹಾಸ",
  "page": 845,
  "src": 194
 },
 {
  "t": "item",
  "text": "ನಚಿಕೇತನಿಗೂ ಯಮನಿಗೂ ನಡೆದ ಸಂಭಾಷಣೆಯ ವಿಷಯದಲ್ಲಿ ತೈತ್ತಿರೀಯಬ್ರಾಹ್ಮಣ ದಲ್ಲಿರುವ ವಿವರಣೆ",
  "page": 847,
  "src": 195
 },
 {
  "t": "item",
  "text": "ಅತಿಥಿಯನ್ನು ಸತ್ಕಾರ ಮಾಡದೆ ಅಲಕ್ಷ್ಯ ಮಾಡಿದರೆ ಉಂಟಾಗುವ ಅನರ್ಥ ಇತ್ಯಾದಿ",
  "page": 848,
  "src": 197
 },
 {
  "t": "item",
  "text": "ಯಸ್ಮಿನ್ವೃಕ್ಷೇ ಎಂಬ ಋಕ್ಕಿಗೆ ಯಮನಪರವಾದ ಅರ್ಥ",
  "page": 851,
  "src": 198
 },
 {
  "t": "item",
  "text": "ಅದೇ ಋಕ್ಕಿಗೆ—ಆದಿತ್ಯಪರವಾದ ಅರ್ಥ",
  "page": 852,
  "src": 199
 },
 {
