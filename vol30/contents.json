 },
 {
  "t": "sukta",
  "no": "೧೦೦",
  "text": "ಇಂದ್ರ ದೃಹ್ಯ ಮಘವನ್ ಎಂಬ ನೂರನೆಯ ಸೂಕ್ತ 134",
