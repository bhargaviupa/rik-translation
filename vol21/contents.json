[
 {
  "t": "center",
  "text": "ನಾಲ್ಕನೆಯ ಅಷ್ಟಕದಲ್ಲಿ ಏಳನೆಯ ಅಧ್ಯಾಯವು.",
  "src": 214
 },
 {
  "t": "item",
  "text": "ಆರನೆಯ ಮಂಡಲದ ಸೂಕ್ತಗಳು.",
  "page": null,
  "src": 216
 },
 {
  "t": "sukta",
  "no": "೨೯",
  "text": "ಇಂದ್ರಂ ವೋ ನರಃ ಎಂಬ: ಇಪ್ಪತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತವು— 1",
  "src": 218
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ಪೀಠಿಕೆ—ಋಷಿದೇವತಾಛಂದಸ್ಸುಗಳು ವಿನಿಯೋಗ ಇತ್ಯಾದಿ—",
  "page": 2,
  "src": 219
 },
 {
  "t": "sukta",
  "no": "೩೦",
  "text": "ಭೂಯ ಇದ್ವಾವೃಧೇ ಎಂಬ ಮೂವತ್ತನೆಯ ಸೂಕ್ತವು— 11",
  "src": 220
 },
 {
  "t": "item",
  "text": "ನೂ ಚಿತ್ ಎಂಬ ನಿಪಾತಗಳ ನಿರ್ವಚನ ಇತ್ಯಾದಿ—",
  "page": 15,
  "src": 221
 },
 {
  "t": "sukta",
  "no": "೩೧",
  "text": "ಅಭೂರೇಕಃ ಎಂಬ ಮೂವತ್ತೊಂದನೆಯ ಸೂಕ್ತವು— 19",
  "src": 222
 },
 {
  "t": "sukta",
  "no": "೩೨",
  "text": "ಅಪೂರ್ವಾ ಪುರುತಮಾನಿ ಎಂಬ ಮೂವತ್ತೆರಡನೆಯ ಸೂಕ್ತವು— 25",
  "src": 223
 },
 {
  "t": "sukta",
  "no": "೩೩",
  "text": "ಯ ಓಜಿಷ್ಠ ಇಂದ್ರ ಎಂಬ ಮೂವತ್ತಮೂರನೆಯ ಸೂಕ್ತವು— 31",
  "src": 224
 },
 {
  "t": "sukta",
  "no": "೩೪",
  "text": "ಸಂ ಚ ತ್ವೇ ಜಗ್ಮುಃ ಎಂಬ ಮೂವತ್ತನಾಲ್ಕನೆಯ ಸೂಕ್ತವು— 38",
  "src": 225
 },
 {
  "t": "sukta",
  "no": "೩೫",
  "text": "ಕದಾ ಭುವನ್ ಎಂಬ ಮೂವತ್ತೈದನೆಯ ಸೂಕ್ತವು-- 45",
  "src": 226
 },
 {
  "t": "sukta",
  "no": "೩೬",
  "text": "ಸತ್ರಾ ಮದಾಸಃ ಎಂಬ ಮೂವತ್ತಾರನೆಯ ಸೂಕ್ತವು— 51",
  "src": 227
 },
 {
  "t": "sukta",
  "no": "೩೭",
  "text": "ಅರ್ವಾಗ್ರಥಂ ಎಂಬ ಮೂವತ್ತೇಳನೆಯ ಸೂಕ್ತವು— 58",
  "src": 228
 },
 {
  "t": "sukta",
  "no": "೩೮",
  "text": "ಅಪಾದಿತ ಉದು ಎಂಬ ಮೂವತ್ತೆಂಟನೆಯ ಸೂಕ್ತವು— 65",
  "src": 229
 },
 {
  "t": "sukta",
  "no": "೩೯",
  "text": "ಮಂದ್ರಸ್ಯ ಕನೇಃ ಎಂಬ ಮೂವತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತವು— 72",
  "src": 230
 },
 {
  "t": "sukta",
  "no": "೪೦",
  "text": "ಇಂದ್ರ ಪಿಬ ತುಭ್ಯಂ ಎಂಬ ನಲವತ್ತನೆಯ ಸೂಕ್ತವು— 78",
  "src": 231
 },
 {
  "t": "sukta",
  "no": "೪೧",
  "text": "ಅಹೇಳಮಾನ ಉಪ ಯಾಹಿ ಎಂಬ ನಲವತ್ತೊಂದನೆಯ ಸೂಕ್ತವು— 86",
  "src": 232
 },
 {
  "t": "sukta",
  "no": "೪೨",
  "text": "ಪ್ರತ್ಯಸ್ಮೈ ಪಿಪೀಪತೇ ಎಂಬ ನಲವತ್ತೆರಡನೆಯ ಸೂಕ್ತವು— 92",
  "src": 233
 },
 {
  "t": "sukta",
  "no": "೪೩",
  "text": "ಯಸ್ಯ ತ್ಯಚ್ಛಂಬರಂ ಎಂಬ ನಲವತ್ತಮೂರನೆಯ ಸೂಕ್ತವು— 97",
  "src": 234
 },
 {
  "t": "sukta",
  "no": "೪೪",
  "text": "ಯೋ ರಯಿವಃ ಎಂಬ ನಲವತ್ತಾಲ್ಕನೆಯ ಸೂಕ್ತವು— 102",
  "src": 235
 },
 {
  "t": "sukta",
  "no": "೪೫",
  "text": "ಯ ಆನಯತ್ ಎಂಬ ನಲವತ್ತೈದನೆಯ ಸೂಕ್ತವು— 132",
  "src": 236
 },
 {
  "t": "sukta",
  "no": "೪೬",
  "text": "ತ್ವಾಮಿದ್ದಿ ಹವಾಮಹೇ ಎಂಬ ನಲವತ್ತಾರನೆಯ ಸೂಕ್ತವು— 163",
  "src": 237
 },
 {
  "t": "sukta",
  "no": "೪೭",
  "text": "ಸ್ವಾದುಷ್ಕಿಲಾಯಂ ಎಂಬ ನಲವತ್ತೇಳನೆಯ ಸೂಕ್ತವು— 180",
  "src": 238
 },
 {
  "t": "item",
  "text": "ದೇವತೆಗಳಿಗೆ ಹಸ್ತಾದ್ಯವಯಯವಗಳು, ಮನುಷ್ಯರಿಗಿರುವಂತೆ ಆಕಾರ ಮೊದಲಾದವು ಇರುವುದೇ ಎಂಬ ವಿಚಾರದಲ್ಲಿ ವಿಷಯವಿಮರ್ಶೆ ಮತ್ತು ಯಾಸ್ಕರ ನಿರ್ವಚನ ಮತ್ತು ಅಭಿಪ್ರಾಯಗಳು—",
  "page": 191,
  "src": 244
 },
 {
  "t": "item",
  "text": "ಚೋಷ್ಕೂ ಯತೇ ಎಂಬ ಶಬ್ದಕ್ಕೆ ಯಾಸ್ಕರ ನಿರ್ವಚನ ಇತ್ಯಾದಿ—",
  "page": 206,
  "src": 246
 },
 {
  "t": "item",
  "text": "ಇಂದ್ರನು ಅನೇಕ ರೂಪಗಳನ್ನು ಧರಿಸಬಲ್ಲನೆಂಬ ವಿಷಯದಲ್ಲಿ ವಿಷಯವಿಮರ್ಶೆ ಶ್ರುತ್ಯುದಾಹರಣೆ ಇತ್ಯಾದಿ—",
  "page": 209,
  "src": 247
 },
 {
  "t": "item",
  "text": "ವನಸ್ಪತೇ ವೀಡ್ವಂಗಃ ಎಂಬ ಋಕ್ಕಿಗೆ ಯಾಸ್ಕರ ನಿರುಕ್ತವು—",
  "page": 219,
  "src": 249
 },
 {
  "t": "item",
  "text": "ದುಂದುಭಿಶಬ್ದಾರ್ಥವಿವರಣೆ--",
  "page": 223,
  "src": 250
 },
 {
  "t": "center",
  "text": "ನಾಲ್ಕನೆಯ ಅಷ್ಟಕದಲ್ಲಿ ಏಳನೆಯ ಅಧ್ಯಾಯವು ಸಮಾಪ್ತವು",
  "src": 251
 },
 {
  "t": "center",
  "text": "ಎಂಟನೆಯ ಅಧ್ಯಾಯವು",
  "src": 253
 },
 {
  "t": "sukta",
  "no": "೪೮",
  "text": "ಯಜ್ಞಾಯಜ್ಞಾ ವಃ ಎಂಬ ನಲವತ್ತೆಂಟನೆಯ ಸೂಕ್ತವು— 227",
  "src": 255
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ವಿನಿಯೋಗ ಇತ್ಯಾದಿ—",
  "page": 228,
  "src": 256
 },
 {
  "t": "item",
  "text": "ಯಜ್ಞಾಯಜ್ಞಾ ವಃ ಎಂಬ ಋಕ್ಕಿನ ವಿಷಯದಲ್ಲಿ ಐತರೇಯಬ್ರಾಹ್ಮಣದಲ್ಲಿರುವ ವಿವರಣೆಯು—",
  "page": 231,
  "src": 257
 },
 {
  "t": "sukta",
  "no": "೪೯",
  "text": "ಸ್ತುಷೇ ಜನಂ ಸುವ್ರತಂ ಎಂಬ ನಲವತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತವು— 255",
  "src": 258
 },
 {
  "t": "item",
  "text": "ಪಾವೀರವೀ ಕನ್ಯಾ ಎಂಬ ಋಕ್ಕಿನ ವಿಶೇಷವಿನಿಯೋಗ—",
  "page": 265,
  "src": 259
 },
 {
  "t": "sukta",
  "no": "೫೦",
  "text": "ಹುವೇ ವೋ ದೇವೀಂ ಎಂಬ ಐವತ್ತನೆಯ ಸೂಕ್ತವು— 276",
  "src": 260
 },
 {
  "t": "item",
  "text": "ಮಿಮ್ಯಕ್ಷ ಯೇಷು ರೋದಸೀ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತವು—",
  "page": 283,
  "src": 261
 },
 {
  "t": "sukta",
  "no": "೫೧",
  "text": "ಉದು ತ್ಯಚ್ಚಕ್ಷುಃ ಎಂಬ ಐವತ್ತೊಂದನೆಯ ಸೂಕ್ತವು— 295",
  "src": 262
 },
 {
  "t": "sukta",
  "no": "೫೨",
  "text": "ನ ತದ್ದಿವಾ ನ ಪೃಥಿವ್ಯಾ ಎಂಬ ಐವತ್ತೆರಡನೆಯ ಸೂಕ್ತವು— 315",
  "src": 263
 },
 {
  "t": "sukta",
  "no": "೫೩",
  "text": "ವಯಮು ತ್ವಾ ಪಥಸ್ಪತೇ ಎಂಬ ಐವತ್ತಮೂರನೆಯ ಸೂಕ್ತವು— 335",
  "src": 264
 },
 {
  "t": "sukta",
  "no": "೫೪",
  "text": "ಸಂ ಪೂಷನ್ನಿದುಷಾ ಎಂಬ ಐವತ್ತ ನಾಲ್ಕನೆಯ ಸೂಕ್ತವು— 344",
  "src": 265
 },
 {
  "t": "sukta",
  "no": "೫೫",
  "text": "ಏಹಿ ವಾಂ ವಿಮುಚಃ ಎಂಬ ಐವತ್ತೈದನೆಯ ಸೂಕ್ತವು— 354",
  "src": 266
 },
 {
  "t": "item",
  "text": "ಆಘೃಣೇ ಎಂಬ ಶಬ್ದದ ನಿರ್ವಚನವು—",
  "page": 356,
  "src": 267
 },
 {
  "t": "sukta",
  "no": "೫೬",
  "text": "ಯ ಏನಮಾಡಿದೇಶತಿ ಎಂಬ ಐವತ್ತಾರನೆಯ ಸೂಕ್ತವು— 360",
  "src": 268
 },
 {
  "t": "sukta",
  "no": "೫೭",
  "text": "ಇಂದ್ರಾ ನು ಪೂಷಣಾ ಎಂಬ ಐವತ್ತೇಳನೆಯ ಸೂಕ್ತವು— 367",
  "src": 269
 },
 {
  "t": "sukta",
  "no": "೫೮",
  "text": "ಶುಕ್ರಂ ತೇ ಅನ್ಯತ್ ಎಂಬ ಐವತ್ತೆಂಟನೆಯ ಸೂಕ್ತ— 372",
  "src": 270
 },
 {
  "t": "item",
  "text": "ಶುಕ್ರಂ ತೇ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನ—",
  "page": 375,
  "src": 271
 },
 {
  "t": "sukta",
  "no": "೫೯",
  "text": "ಪ್ರ ನು ವೋಚ ಎಂಬ ಐವತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತವು— 379",
  "src": 272
 },
 {
  "t": "item",
  "text": "ಜೋಷವಾಕಂ ಎಂಬ ಶಬ್ದದ ನಿರ್ವಚನ, ವಿವರಣೆ ಇತ್ಯಾದಿ—",
  "page": 383,
  "src": 273
 },
 {
  "t": "sukta",
  "no": "೬೦",
  "text": "ಶ್ವಥದ್ವೃತ್ರಂ ಎಂಬ ಅರವತ್ತನೆಯ ಸೂಕ್ತವು— 391",
  "src": 274
 },
 {
  "t": "sukta",
  "no": "೬೧",
  "text": "ಇಯಮದದಾತ್ ಎಂಬ ಅರವತ್ತೊಂದನೆಯ ಸೂಕ್ತ— 498",
  "src": 280
 },
 {
  "t": "item",
  "text": "ಇಯಂ ಶುಷ್ಮೇಭಿಃ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು—",
  "page": 411,
  "src": 281
 },
 {
  "t": "center",
  "text": "ನಾಲ್ಕನೆಯ ಅಷ್ಟಕದಲ್ಲಿ ಎಂಟನೆಯ ಅಧ್ಯಾಯವು ಸಮಾಪ್ತವು",
  "src": 283
 },
 {
  "t": "center",
  "text": "ಐದನೆಯ ಅಷ್ಟಕದಲ್ಲಿ ಮೊದಲನೆಯ ಅಧ್ಯಾಯವು",
  "src": 285
 },
 {
  "t": "sukta",
  "no": "೬೨",
  "text": "ಸ್ತುಷೇ ನರಾ ದಿವಃ ಎಂಬ ಅರವತ್ತೆರಡನೆಯ ಸೂಕ್ತವು— 425",
  "src": 287
 },
 {
  "t": "sukta",
  "no": "೬೩",
  "text": "ಕ್ವ ೧ ತ್ಯಾ ವಲ್ಲೂ ಎಂಬ ಅರವತ್ತಮೂರನೆಯ ಸೂಕ್ತ— 440",
  "src": 288
 },
 {
  "t": "sukta",
  "no": "೬೪",
  "text": "ಉದು ಶ್ರಿಯ ಉಷಸಃ ಎಂಬ ಅರವತ್ತನಾಲ್ಕನೆಯ ಸೂಕ್ತ— 453",
  "src": 289
 },
 {
  "t": "sukta",
  "no": "೬೫",
  "text": "ಏಷಾ ಸ್ಯಾ ನಃ ಎಂಬ ಅರವತ್ತೈದನೆಯ ಸೂಕ್ತ— 460",
  "src": 290
 },
 {
  "t": "sukta",
  "no": "೬೬",
  "text": "ವಪುರ್ನು ತಶ್ಕಿತುಷೇ ಎಂಬ ಅರವತ್ತಾರನೆಯ ಸೂಕ್ತ— 468",
  "src": 291
 },
 {
  "t": "sukta",
  "no": "೬೭",
  "text": "ವಿತ್ವೇಷಾಂ ವಃ ಸತಾಂ ಎಂಬ ಅರವತ್ತೇಳನೆಯ ಸೂಕ್ತ— 482",
  "src": 292
 },
 {
  "t": "sukta",
  "no": "೬೮",
  "text": "ಶ್ರುಷ್ಟೀ ವಾಂ ಯಜ್ಞಃ ಎಂಬ ಅರವತ್ತೆಂಟನೆಯ ಸೂಕ್ತ— 497",
  "src": 293
 },
 {
  "t": "sukta",
  "no": "೬೯",
  "text": "ಸಂ ವಾಂ ಕರ್ಮಣಾ ಎಂಬ ಅರವತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತವು— 511",
  "src": 294
 },
 {
  "t": "sukta",
  "no": "೭೦",
  "text": "ಧೃತವತೀ ಭುವನಾನಾಂ ಎಂಬ ಎಪ್ಪತ್ತನೆಯ ಸೂಕ್ತವು— 521",
  "src": 295
 },
 {
  "t": "sukta",
  "no": "೭೧",
  "text": "ಉದು ಷ್ಯ ದೇವಃ ಎಪ್ಪತ್ತೊಂದನೆಯ ಸೂಕ್ತವು— 530",
  "src": 296
 },
 {
  "t": "sukta",
  "no": "೭೨",
  "text": "ಇಂದ್ರಾಸೋಮಾ ಮಹಿ ಎಂಬ ಎಪ್ಪತ್ತೆರಡನೆಯ ಸೂಕ್ತವು— 539",
  "src": 297
 },
 {
  "t": "sukta",
  "no": "೭೩",
  "text": "ಯೋ ಅದ್ರಿಭಿತ್ ಎಂಬ ಎಪ್ಪತ್ತಮೂರನೆಯ ಸೂಕ್ತವು— 545",
  "src": 298
 },
 {
  "t": "sukta",
  "no": "೭೪",
  "text": "ಸೋಮಾರುದ್ರಾ ಧಾರಯೇಥಾಂ ಎಂಬ ಎಪ್ಪತ್ತನಾಲ್ಕನೆಯ ಸೂಕ್ತವು— 549",
  "src": 299
 },
 {
  "t": "sukta",
  "no": "೭೫",
  "text": "ಜೀಮೂತಸ್ಯೇವ ಭವತಿ ಎಂಬ ಎಪ್ಪತ್ತೈದನೆಯ ಸೂಕ್ತವು— 555",
  "src": 300
 },
 {
  "t": "item",
  "text": "ಧನುಶ್ಯಬ್ದದ ನಿರ್ವಚನ ಇತ್ಯಾದಿ—",
  "page": 560,
  "src": 301
 },
 {
  "t": "item",
  "text": "ಕವಚ ಮತ್ತು ಜ್ಯಾ (ಹೆದೆ) ಗಳ ವಿದರಣೆ ಇತ್ಯಾದಿ—",
  "page": 562,
  "src": 302
 },
 {
  "t": "item",
  "text": "ವಕ್ಷ್ಯಂತೀವೇದಾ ಎಂಬ ಋಕ್ಕಿಗೆ ಯಾಸ್ಕರ ನಿರುಕ್ತವು—",
  "page": 563,
  "src": 303
 },
 {
  "t": "item",
  "text": "ತೇ ಆಚರಂತೀ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು (ಆರ್ತಿ)",
  "page": 565,
  "src": 304
 },
 {
  "t": "item",
  "text": "ಇಷುಧಿಶಬ್ದಾರ್ಥವಿವರಣೆ ; ಬಹ್ನೀನಾಂ ಪಿತಾ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು—",
  "page": 568,
  "src": 305
 },
 {
  "t": "item",
  "text": "ಸಾರಥಿ ಮತ್ತು ಲಗಾಮುಗಳ ವಿವರಣೆ; ರಥೇ ತಿಷ್ಠನ್ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು—",
  "page": 571,
  "src": 306
 },
 {
  "t": "item",
  "text": "ರಥಗೋಪರವಿವರಣೆ ; ಸ್ವಾದುಷಂಸದಃ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು—",
  "page": 576,
  "src": 307
 },
 {
  "t": "item",
  "text": "ಬಾಣಸ್ತುತಿ ; ಸುಪರ್ಣಂ ವಸ್ತ್ರೇ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು",
  "page": 580,
  "src": 308
 },
 {
  "t": "item",
  "text": "ಕಶಾ ಅಥವಾ ಅಶ್ವಾಜನಿಯ ವಿವರಣೆ; ಆ ಜಘಂತಿ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು—",
  "page": 583,
  "src": 309
 },
 {
  "t": "item",
  "text": "ಹಸ್ತಘ್ನದ ವಿವರಣೆ ; ಅಹಿರಿವ ಭೋಗೈಃ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು",
  "page": 586,
  "src": 317
 },
 {
  "t": "mandala",
  "text": "ಇಲ್ಲಿಗೆ ಆರನೆಯ ಮಂಡಲವು ಸಮಾಪ್ತವು.",
  "src": 318
 },
 {
  "t": "center",
  "text": "ಏಳನೆಯ ಮಂಡಲವು",
  "src": 320
 },
 {
  "t": "item",
  "text": "ಏಳನೆಯ ಮಂಡಲದ ಪೀಠಿಕೆ—",
  "page": 595,
  "src": 322
 },
 {
  "t": "item",
  "text": "ವಸಿಷ್ಠ ಋಷಿಯ ಸೂಕ್ಷ್ಮ ಪರಿಚಯ—",
  "page": 596,
  "src": 323
 },
 {
  "t": "item",
  "text": "ವಸಿಷ್ಠ ಋಷಿಯ ಉತ್ಪತ್ತಿ ಮತ್ತು ಅವನ ಮಾಹಾತ್ಮ್ಯ—",
  "page": 596,
  "src": 324
 },
 {
  "t": "item",
  "text": "ವಸಿಷ್ಠ ಮತ್ತು ಸುದಾಸ—",
  "page": 606,
  "src": 325
 },
 {
  "t": "item",
  "text": "ವಸಿಷ್ಠ ಮತ್ತು ವಿಶ್ವಾಮಿತ್ರ—",
  "page": 609,
  "src": 326
 },
 {
  "t": "sukta",
  "no": "೧",
  "text": "ಅಗ್ನಿಂ ನರೋ ದೀಧಿತಿಂ ಎಂಬ ಮೊದಲನೆಯ ಸೂಕ್ತವು— 616",
  "src": 327
 },
 {
  "t": "item",
  "text": "ಸೂಕ್ತದ ವಿನಿಯೋಗ ಮತ್ತು ಋಷಿದೇವತಾಛಂದಸ್ಸುಗಳು ಇತ್ಯಾದಿ—",
  "page": 617,
  "src": 328
 },
 {
  "t": "item",
  "text": "ಅಥರ್ಯು೦ ಎಂಬ ಶಬ್ದದ ನಿರ್ವಚನ ಮತ್ತು ಅರ್ಥವಿವರಣೆ—",
  "page": 619,
  "src": 329
 },
 {
  "t": "center",
  "text": "ಐದನೆಯ ಅಷ್ಟಕದಲ್ಲಿ ಮೊದಲನೆಯ ಅಧ್ಯಾಯವು ಸಮಾಪ್ತವು",
  "src": 330
 },
 {
  "t": "item",
  "text": "ಎರಡನೆಯ ಅಧ್ಯಾಯವು ಆಪ್ರೀಸೂಕ್ತಗಳ ವಿಷಯದಲ್ಲಿ ಪೀಠಿಕೆ—",
  "page": 648,
  "src": 332
 },
 {
  "t": "sukta",
  "no": "೨",
  "text": "ಜುಷಸ್ವ ನಃ ಎಂಬ ಎರಡನೆಯ ಸೂಕ್ತವು— 653",
  "src": 334
 },
 {
  "t": "item",
  "text": "ನರಾಶಂಸಸ್ಯ ಮಹಿಮಾನಂ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನವು—",
  "page": 656,
  "src": 335
 },
 {
  "t": "sukta",
  "no": "೩",
  "text": "ಅಗ್ನಿಂವೋ ದೇವಂ ಎಂಬ ಮೂರನೆಯ ಸೂಕ್ತವು— 667",
  "src": 336
 },
 {
  "t": "sukta",
  "no": "೪",
  "text": "ಪ್ರ ವಃ ಶುಕ್ರಾಯ ಎಂಬ ನಾಲ್ಕನೆಯ ಸೂಕ್ತವು— 679",
  "src": 337
 },
 {
  "t": "item",
  "text": "ಅಪತ್ಯಶಬ್ದಾರ್ಥವಿಚಾರ ಮತ್ತು ನಿರ್ವಚನ ; ಪರಿಷದ್ಯಂ ಎಂಬ ಋಕ್ಕಿನ ನಿರ್ವಚನ ಇತ್ಯಾದಿ—",
  "page": 688,
  "src": 338
 },
 {
  "t": "item",
  "text": "ನಹಿ ಗ್ರಭಾಯ ಎಂಬ ಋಕ್ಕಿನ ನಿರುಕ್ತವು—",
  "page": 692,
  "src": 339
 },
 {
  "t": "sukta",
  "no": "೫",
  "text": "ಪ್ರಾಗ್ನಯೇ ತವಸೇ ಎಂಬ ಐದನೆಯ ಸೂಕ್ತವು— 695",
  "src": 340
 },
 {
  "t": "sukta",
  "no": "೬",
  "text": "ಪ್ರ ಸಮ್ರಾಜಃ ಎಬ ಆರನೆಯ ಸೂಕ್ತವು— 705",
  "src": 341
 },
 {
  "t": "sukta",
  "no": "೭",
  "text": "ಪ್ರ ವೋ ದೇವಂ ಎಂಬ ಏಳನೆಯ ಸೂಕ್ತವು— 714",
  "src": 342
 },
 {
  "t": "sukta",
  "no": "೮",
  "text": "ಇಂಥೇ ರಾಜಾ ಎಂಬ ಎಂಟನೆಯ ಸೂಕ್ತ— 723",
  "src": 343
 },
 {
  "t": "sukta",
  "no": "೯",
  "text": "ಅಬೋಧಿ ಜಾರಃ ಎಂಬ ಒಂಭತ್ತನೆಯ ಸೂಕ್ತ— 731",
  "src": 344
 },
 {
  "t": "sukta",
  "no": "೧೦",
  "text": "ಉಷೋ ನ ಜಾರಃ ಎಂಬ ಹತ್ತನೆಯ ಸೂಕ್ತ— 739",
  "src": 350
 },
 {
  "t": "sukta",
  "no": "೧೧",
  "text": "ಮಹಾ ಅಸ್ಯಧ್ವರಸ್ಯ ಎಂಬ ಹನ್ನೊಂದನೆಯ ಸೂಕ್ತವು— 746",
  "src": 351
 },
 {
  "t": "sukta",
  "no": "೧೨",
  "text": "ಅಗನ್ಮ ಮಹಾ ನಮಸಾ ಎಂಬ ಹನ್ನೆರಡನೆಯ ಸೂಕ್ತವು— 752",
  "src": 352
 },
 {
  "t": "sukta",
  "no": "೧೩",
  "text": "ಪ್ರಾಗ್ನಯೇ ವಿಶ್ವಶುಚೇ ಎಂಬ ಹದಿಮೂರನೆಯ ಸೂಕ್ತವು— 756",
  "src": 353
 },
 {
  "t": "sukta",
  "no": "೧೪",
  "text": "ಸಮಿಧಾ ಜಾತವೇದಸೇ—ಎಂಬ ಹದಿನಾಲ್ಕನೆಯ ಸೂಕ್ತವು— 759",
  "src": 354
 },
 {
  "t": "sukta",
  "no": "೧೫",
  "text": "ಉಪಸದ್ಯಾಯ ಎಂಬ ಹದಿನೈದನೆಯ ಸೂಕ್ತವು— 763",
  "src": 355
 },
 {
  "t": "sukta",
  "no": "೧೬",
  "text": "ಏನಾ ವೋ ಅಗ್ನಿಂ ಎಂಬ ಹದಿನಾರನೆಯ ಸೂಕ್ತವು— 777",
  "src": 356
 },
 {
  "t": "item",
  "text": "ಏನಾ ಶಬ್ದದ ಅರ್ಥ ಮತ್ತು ಪ್ರಯೋಗ",
  "page": 779,
  "src": 357
 },
 {
  "t": "sukta",
  "no": "೧೭",
  "text": "ಅಗ್ನೇ ಭವ ಸುಷಮಿಧಾ ಎಂಬ ಹದಿನೇಳನೆಯ ಸೂಕ್ತವು— 791",
  "src": 358
 },
 {
  "t": "sukta",
  "no": "೧೮",
  "text": "ತೈ ಹ ಯತ್ಪಿತರಃ ಎಂಬ ಹದಿನೆಂಟನೆಯ ಸೂಕ್ತವು— 797",
  "src": 359
 },
 {
  "t": "sukta",
  "no": "೧೯",
  "text": "ಯಸ್ತಿಗೃಶೃಂಗಃ ಎಂಬ ಹತ್ತೊಂಭತ್ತನೆಯ ಸೂಕ್ತವು— 828",
  "src": 360
 }
]